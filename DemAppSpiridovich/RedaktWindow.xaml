<Window x:Class="DemAppSpiridovich.RedaktWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Редактирование товара"
        Height="550" Width="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

      
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Артикул:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbArticle" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Наименование:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbName" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Единица измерения:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbUnit" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Цена:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbPrice" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Поставщик:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbSupplier" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Производитель:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbManufacturer" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Категория:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbCategory" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Скидка (%):" Margin="0,5,0,2"/>
                <TextBox x:Name="tbDiscount" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Количество на складе:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbQuantity" Height="25" Margin="0,0,0,10"/>

                <TextBlock Text="Описание:" Margin="0,5,0,2"/>
                <TextBox x:Name="tbDescription" Height="50" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Фото (имя файла):" Margin="0,5,0,2"/>
                <TextBox x:Name="tbPhoto" Height="25" Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Background="#00FA9A" BorderBrush="#00FA9A" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="30" Background="#7FFF00" BorderBrush="#7FFF00" Click="btnCancel_Click"/>
        </StackPanel>

    </Grid>
</Window>