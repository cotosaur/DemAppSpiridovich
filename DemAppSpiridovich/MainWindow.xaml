<Window x:Class="DemAppSpiridovich.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemAppSpiridovich"
        mc:Ignorable="d"
        Title="Авторизация - ООО'Обувь'" Height="450" Width="364" Icon="/photo/Icon.ico">
    <Grid>
        <Label Content="Авторизация" HorizontalAlignment="Center" Margin="0,126,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Button x:Name="btLog" Content="Войти" HorizontalAlignment="Center" Margin="0,285,0,0" VerticalAlignment="Top" Height="27" Width="92" Click="btLog_Click" Background="MediumSpringGreen"/>
        <TextBox x:Name="tblog" HorizontalAlignment="Center" Margin="0,190,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="224" Height="27"/>
        <PasswordBox x:Name="pbox" HorizontalAlignment="Center" VerticalAlignment="Top" Width="224" Margin="0,248,0,0" Height="24"/>
        <Button x:Name="btGust" Content="Продолжить как гость" HorizontalAlignment="Center" Margin="0,317,0,0" VerticalAlignment="Top" BorderBrush="{x:Null}" Background="{x:Null}" Click="btGust_Click" FontSize="10"/>
        <Image HorizontalAlignment="Center" Height="72" Margin="0,47,0,0" VerticalAlignment="Top" Width="76" Source="/photo/Icon.png"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="70,164,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="70,222,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
